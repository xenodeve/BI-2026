                                          <parameter key="days_diff(%{loop_attribute1}, %{loop_attribute2})" value="date_diff(#{loop_attribute1}, #{loop_attribute2})/(1000.0*3600.0*24)" />
                                        </list>
                                        <parameter key="keep_all" value="true" />
                                        <description align="center" color="transparent" colored="false" width="126">Generate the difference for the two date columns in milliseconds.</description>
