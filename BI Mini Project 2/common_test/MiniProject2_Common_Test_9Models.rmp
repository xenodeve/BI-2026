                      <operator activated="true" class="branch" compatibility="12.1.001" expanded="true" height="103" name="LR__Branch if Dates" origin="GENERATED_AUTOMODEL" width="90" x="179" y="34">
                        <parameter key="condition_type" value="min_attributes" />
