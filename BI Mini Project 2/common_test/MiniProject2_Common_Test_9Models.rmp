                                    </process>
                                    <description align="center" color="transparent" colored="false" width="126">Only calculate the differences between the two date columns if the columns are not equal and if the other way around has not been calculated yet.</description>
                                  </operator>
                                  <connect from_port="input 1" to_op="FLM__Select Attributes" to_port="example set input" />
