                                    <description align="center" color="transparent" colored="false" width="126">Select the other way around here and store in the macro if that column already exists.</description>
                                  </operator>
                                  <operator activated="true" class="extract_macro" compatibility="12.1.001" expanded="true" height="68" name="RF__Extract Macro" origin="GENERATED_AUTOMODEL" width="90" x="246" y="34">
