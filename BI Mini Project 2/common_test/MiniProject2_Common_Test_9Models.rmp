                                    <parameter key="include_special_attributes" value="true" />
                                    <description align="center" color="transparent" colored="false" width="126">Select the other way around here and store in the macro if that column already exists.</description>
                                  </operator>
                                  <operator activated="true" class="extract_macro" compatibility="12.1.001" expanded="true" height="68" name="FLM__Extract Macro" origin="GENERATED_AUTOMODEL" width="90" x="246" y="34">
                                    <parameter key="macro" value="existing_diffs" />
                                    <parameter key="macro_type" value="number_of_attributes" />
                                    <parameter key="statistics" value="average" />
                                    <parameter key="attribute_name" value="" />
