<?xml version='1.0' encoding='UTF-8'?>
<process version="12.1.001">
  <context>
    <input />
    <output />
    <macros />
  </context>
  <operator class="process" compatibility="12.1.001" expanded="true" name="Root" activated="true">
    <parameter key="random_seed" value="2026" />
    <parameter key="encoding" value="UTF-8" />
    <process expanded="true">
      <operator class="generate_macro" compatibility="12.1.001" expanded="true" height="103" width="90" name="Portable Paths" x="30" y="30" activated="true">
        <list key="function_descriptions">
          <parameter key="dataset_path" value="replace(%{process_path}, %{process_file}, &quot;heart_2020_cleaned.csv&quot;)" />
          <parameter key="prepared_path" value="replace(%{process_path}, %{process_file}, &quot;heart_2020_prepared_native.csv&quot;)" />
        </list>
      </operator>
      <operator class="read_csv" compatibility="12.1.001" expanded="true" height="103" width="90" name="Read Original 2020 Heart Data" x="30" y="180" activated="true">
        <parameter key="csv_file" value="%{dataset_path}" />
        <parameter key="column_separators" value="," />
        <parameter key="first_row_as_names" value="true" />
        <parameter key="parse_numbers" value="true" />
        <parameter key="decimal_character" value="." />
        <parameter key="trim_lines" value="true" />
        <parameter key="use_quotes" value="true" />
        <parameter key="encoding" value="UTF-8" />
        <parameter key="read_not_matching_values_as_missings" value="false" />
        <list key="data_set_meta_data_information">
          <parameter key="0" value="HeartDisease.true.binominal.attribute" />
          <parameter key="1" value="BMI.true.real.attribute" />
          <parameter key="2" value="Smoking.true.polynominal.attribute" />
          <parameter key="3" value="AlcoholDrinking.true.polynominal.attribute" />
          <parameter key="4" value="Stroke.true.polynominal.attribute" />
          <parameter key="5" value="PhysicalHealth.true.real.attribute" />
          <parameter key="6" value="MentalHealth.true.real.attribute" />
          <parameter key="7" value="DiffWalking.true.polynominal.attribute" />
          <parameter key="8" value="Sex.true.polynominal.attribute" />
          <parameter key="9" value="AgeCategory.true.polynominal.attribute" />
          <parameter key="10" value="Race.true.polynominal.attribute" />
          <parameter key="11" value="Diabetic.true.polynominal.attribute" />
          <parameter key="12" value="PhysicalActivity.true.polynominal.attribute" />
          <parameter key="13" value="GenHealth.true.polynominal.attribute" />
          <parameter key="14" value="SleepTime.true.real.attribute" />
          <parameter key="15" value="Asthma.true.polynominal.attribute" />
          <parameter key="16" value="KidneyDisease.true.polynominal.attribute" />
          <parameter key="17" value="SkinCancer.true.polynominal.attribute" />
        </list>
      </operator>
      <operator class="multiply" compatibility="12.1.001" expanded="true" height="103" width="90" name="Keep Raw View" x="180" y="180" activated="true" />
      <operator class="generate_attributes" compatibility="12.1.001" expanded="true" height="103" width="90" name="Any Unhealthy Days" x="330" y="110" activated="true">
        <parameter key="keep_all" value="true" />
        <list key="function_descriptions">
          <parameter key="AnyUnhealthyDays" value="if((PhysicalHealth &gt; 0) || (MentalHealth &gt; 0), &quot;Yes&quot;, &quot;No&quot;)" />
        </list>
      </operator>
      <operator class="write_csv" compatibility="12.1.001" expanded="true" height="103" width="90" name="Export Prepared Native CSV" x="480" y="110" activated="true">
        <parameter key="csv_file" value="%{prepared_path}" />
        <parameter key="column_separator" value="," />
        <parameter key="write_attribute_names" value="true" />
        <parameter key="quote_nominal_values" value="true" />
        <parameter key="append_to_file" value="false" />
        <parameter key="encoding" value="UTF-8" />
      </operator>
      <operator class="set_role" compatibility="12.1.001" expanded="true" height="103" width="90" name="HeartDisease Label" x="630" y="110" activated="true">
        <parameter key="attribute_name" value="HeartDisease" />
        <parameter key="target_role" value="label" />
      </operator>
      <connect from_port="output" to_port="input" from_op="Read Original 2020 Heart Data" to_op="Keep Raw View" />
      <connect from_port="output 1" to_port="example set input" from_op="Keep Raw View" to_op="Any Unhealthy Days" />
      <connect from_port="output 2" to_port="result 2" from_op="Keep Raw View" />
      <connect from_port="example set output" to_port="input" from_op="Any Unhealthy Days" to_op="Export Prepared Native CSV" />
      <connect from_port="through" to_port="example set input" from_op="Export Prepared Native CSV" to_op="HeartDisease Label" />
      <connect from_port="example set output" to_port="result 1" from_op="HeartDisease Label" />
      <description align="left" color="yellow" colored="false" height="140" width="820" x="30" y="380">WS4 follows BI06 Data Quality/Turbo Prep. Retain all319795 anonymous survey respondents: matching profiles are not proven duplicate identities. No imputation: missing0. Retain numeric extremes and review IQR flags. Create AnyUnhealthyDays without label. Raw original filename and bytes preserved. Native TurboPrep screenshots and Run still require actual app evidence.</description>
      <portSpacing port="source_input 1" spacing="0" />
      <portSpacing port="sink_result 1" spacing="0" />
      <portSpacing port="sink_result 2" spacing="0" />
      <portSpacing port="sink_result 3" spacing="0" />
    </process>
  </operator>
</process>