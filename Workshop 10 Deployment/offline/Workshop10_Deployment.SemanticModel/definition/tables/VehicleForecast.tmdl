table 'VehicleForecast'

	measure 'Actual Registrations' = SUM(VehicleForecast[ActualRegistrations])
		formatString: #,0 "vehicles"

	measure 'Forecast Registrations' = SUM(VehicleForecast[ForecastRegistrations])
		formatString: #,0 "vehicles"

	measure 'Future Forecast' = CALCULATE(SUM(VehicleForecast[ForecastRegistrations]), VehicleForecast[DatasetSegment] = "Future")
		formatString: #,0 "vehicles"

	column 'Date'
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: Date

	column 'ActualRegistrations'
		dataType: double
		summarizeBy: none
		sourceColumn: ActualRegistrations

	column 'ForecastRegistrations'
		dataType: double
		summarizeBy: none
		sourceColumn: ForecastRegistrations

	column 'DatasetSegment'
		dataType: string
		summarizeBy: none
		sourceColumn: DatasetSegment

	column 'Model'
		dataType: string
		summarizeBy: none
		sourceColumn: Model

	partition 'VehicleForecast' = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("D:/Github/BI 2026/Workshop 10 Deployment/DLT_Vehicle_Forecast_PowerBI.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
			    Typed = Table.TransformColumnTypes(Nulls, {{"Date", type date}, {"ActualRegistrations", type number}, {"ForecastRegistrations", type number}, {"DatasetSegment", type text}, {"Model", type text}}, "en-US")
			in
			    Typed
