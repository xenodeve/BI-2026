table DimBrand

	column BrandKey
		dataType: int64
		summarizeBy: none
		sourceColumn: BrandKey

	column Brand
		dataType: string
		summarizeBy: none
		sourceColumn: Brand

	partition DimBrand = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("D:/Github/BI 2026/BI Term Project/DimBrand.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Nulls, {{"BrandKey", Int64.Type}, {"Brand", type text}}, "en-US")
				in
				    Typed

