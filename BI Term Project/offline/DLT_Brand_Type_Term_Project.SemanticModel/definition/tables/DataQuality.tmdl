table DataQuality

	measure 'Raw Records' = SUM(DataQuality[SourceRecords])
		formatString: #,0

	measure 'Raw Registrations' = SUM(DataQuality[SourceRegistrations])
		formatString: #,0 "registrations"

	measure 'Complete Source Months' = CALCULATE(COUNTROWS(DataQuality), DataQuality[UsedForModeling] = TRUE())
		formatString: #,0

	measure 'Incomplete Registrations' = CALCULATE(SUM(DataQuality[SourceRegistrations]), DataQuality[IsComplete] = FALSE())
		formatString: #,0 "registrations"

	column Date
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: Date

	column SourceRegistrations
		dataType: int64
		summarizeBy: none
		sourceColumn: SourceRegistrations

	column SourceRecords
		dataType: int64
		summarizeBy: none
		sourceColumn: SourceRecords

	column IsComplete
		dataType: boolean
		summarizeBy: none
		sourceColumn: IsComplete

	column UsedForModeling
		dataType: boolean
		summarizeBy: none
		sourceColumn: UsedForModeling

	partition DataQuality = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("D:/Github/BI 2026/BI Term Project/DataQuality.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Nulls, {{"Date", type date}, {"SourceRegistrations", Int64.Type}, {"SourceRecords", Int64.Type}, {"IsComplete", type logical}, {"UsedForModeling", type logical}}, "en-US")
				in
				    Typed

