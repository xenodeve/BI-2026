table TestErrors

	measure 'Absolute Test Error' = SUM(TestErrors[AbsoluteError])
		formatString: #,0.00

	column SeriesKey
		dataType: string
		summarizeBy: none
		sourceColumn: SeriesKey

	column SegmentType
		dataType: string
		summarizeBy: none
		sourceColumn: SegmentType

	column SegmentName
		dataType: string
		summarizeBy: none
		sourceColumn: SegmentName

	column Date
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: Date

	column ActualRegistrations
		dataType: double
		summarizeBy: none
		sourceColumn: ActualRegistrations

	column PredictedRegistrations
		dataType: double
		summarizeBy: none
		sourceColumn: PredictedRegistrations

	column AbsoluteError
		dataType: double
		summarizeBy: none
		sourceColumn: AbsoluteError

	column Model
		dataType: string
		summarizeBy: none
		sourceColumn: Model

	partition TestErrors = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("D:/Github/BI 2026/BI Term Project/TestErrors.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Nulls, {{"SeriesKey", type text}, {"SegmentType", type text}, {"SegmentName", type text}, {"Date", type date}, {"ActualRegistrations", type number}, {"PredictedRegistrations", type number}, {"AbsoluteError", type number}, {"Model", type text}}, "en-US")
				in
				    Typed

