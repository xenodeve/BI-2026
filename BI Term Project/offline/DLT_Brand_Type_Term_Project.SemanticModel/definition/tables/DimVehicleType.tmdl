table DimVehicleType

	column VehicleTypeKey
		dataType: int64
		summarizeBy: none
		sourceColumn: VehicleTypeKey

	column VehicleType
		dataType: string
		summarizeBy: none
		sourceColumn: VehicleType

	column VehicleTypeEnglish
		dataType: string
		summarizeBy: none
		sourceColumn: VehicleTypeEnglish

	partition DimVehicleType = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("D:/Github/BI 2026/BI Term Project/DimVehicleType.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Nulls, {{"VehicleTypeKey", Int64.Type}, {"VehicleType", type text}, {"VehicleTypeEnglish", type text}}, "en-US")
				in
				    Typed

